# =============================================================================
# Mandados Website — environment variables
# =============================================================================
# Copy this file to .env.local for local dev, or set these in the deploy
# environment (Vercel project settings, etc).
#
# Never commit real values — .env.local is gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Resend (transactional email for the contact form)
# -----------------------------------------------------------------------------
# Required. Get a key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Address used as the "From" header on outgoing email.
# Must be on a domain verified in Resend. Falls back to info@mandados.cr.
FROM_EMAIL=info@mandados.cr
